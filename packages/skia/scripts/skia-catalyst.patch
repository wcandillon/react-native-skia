[apple] Build Mac Catalyst with the iOS ABI and macOS SDK

Overriding flags in build scripts is not enough: Skia still sets macOS target
flags, and Dawn has its own CMake build. Mixing macOS and Catalyst objects
makes xcodebuild -create-xcframework fail:
  error: binaries with multiple platforms are not supported 'lib~.a'

Catalyst also needs the macOS SDK's iOSSupport headers and frameworks.
Flags alone cannot fix Dawn's iOS-only Metal feature-set checks, which fail:
  error: '...' is unavailable: not available on macCatalyst
The source guards for those checks are in metal-maccatalyst.patch.

Declare the Catalyst environment in GN and set its compiler/assembler/linker
targets. Use ios_min_target for both Catalyst and macOS deployment targets;
each target has its own GN build arguments.

Drop this patch when the pinned Skia includes equivalent Catalyst support.

---
--- a/gn/BUILDCONFIG.gn
+++ b/gn/BUILDCONFIG.gn
@@ -34,6 +34,7 @@
   ios_min_target = ""
   ios_use_simulator =
       target_os == "ios" && (target_cpu == "x86" || target_cpu == "x64")
+  target_environment = ""

   # Enable -H, which prints the include tree during compilation.
   # For use by external tools for analyzing include files.
@@ -68,6 +69,7 @@
 is_tvos = current_os == "tvos"
 is_linux = current_os == "linux"
 is_mac = current_os == "mac"
+is_catalyst = target_environment == "catalyst"
 is_wasm = current_os == "wasm"
 is_win = current_os == "win"

--- a/gn/skia/BUILD.gn
+++ b/gn/skia/BUILD.gn
@@ -264,44 +264,55 @@
         "-isysroot",
         xcode_sysroot,
       ]
-    }
-
+      if (is_catalyst) {
+        # Required flags for Mac Catalyst
+        cflags += [
+          "-isystem",
+          "$xcode_sysroot/System/iOSSupport/usr/include",
+          "-iframework",
+          "$xcode_sysroot/System/iOSSupport/System/Library/Frameworks",
+        ]
+        ldflags += [
+          "-iframework",
+          "$xcode_sysroot/System/iOSSupport/System/Library/Frameworks",
+        ]
+      }
+    }
     # Disable linker warnings.  They're usually just annoyances like,
     #   ld: warning: text-based stub file
     #     /System/Library/Frameworks/foo.framework/foo.tbd and library file
     #     /System/Library/Frameworks/foo.framework/foo are out of sync.
     #     Falling back to library file for linking.
     ldflags += [ "-Wl,-w" ]
-
     # As of 11/2020, gn is an x86 binary and defaults the host_cpu to x86_64.
     # This allows you to build arm64 mac binaries by setting target_cpu = "arm64"
-    if (current_cpu == "arm64") {
-      asmflags += [
-        "-target",
-        "arm64-apple-macos11",
-      ]
-      cflags += [
-        "-target",
-        "arm64-apple-macos11",
-      ]
-      ldflags += [
-        "-target",
-        "arm64-apple-macos11",
-      ]
+    assert(ios_min_target != "",
+           "ios_min_target is required for macOS and Mac Catalyst")
+    if (is_catalyst) {
+      if (current_cpu == "arm64") {
+        _mac_target = "arm64-apple-ios${ios_min_target}-macabi"
+      } else {
+        _mac_target = "x86_64-apple-ios${ios_min_target}-macabi"
+      }
     } else {
-      asmflags += [
-        "-target",
-        "x86_64-apple-macos11",
-      ]
-      cflags += [
-        "-target",
-        "x86_64-apple-macos11",
-      ]
-      ldflags += [
-        "-target",
-        "x86_64-apple-macos11",
-      ]
-    }
+      if (current_cpu == "arm64") {
+        _mac_target = "arm64-apple-macos${ios_min_target}"
+      } else {
+        _mac_target = "x86_64-apple-macos${ios_min_target}"
+      }
+    }
+    asmflags += [
+      "-target",
+      _mac_target,
+    ]
+    cflags += [
+      "-target",
+      _mac_target,
+    ]
+    ldflags += [
+      "-target",
+      _mac_target,
+    ]
   }

