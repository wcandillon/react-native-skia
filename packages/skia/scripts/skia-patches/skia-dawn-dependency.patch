[apple] Configure Skia's Dawn dependency for iOS and tvOS

Map the GN platform and CPU to CMake, pass the simulator choice, and select
the matching Apple SDK. Disable Tint command-line tools for cross builds.
Link Cocoa only on native macOS, excluding iOS, tvOS, and Mac Catalyst.

These rules build Skia's non-shipped libdawn_combined dependency; the
standalone monolithic Dawn build uses dawn-configuration.ts instead.

---
# Keep Cocoa macOS-only and pass the Apple simulator choice to Dawn.
diff --git a/third_party/dawn/BUILD.gn b/third_party/dawn/BUILD.gn
--- a/third_party/dawn/BUILD.gn
+++ b/third_party/dawn/BUILD.gn
@@ -164,8 +164,10 @@
       "IOKit.framework",
       "Metal.framework",
       "QuartzCore.framework",
-      "Cocoa.framework",
     ]
+    if (is_mac && !is_catalyst) {
+      frameworks += [ "Cocoa.framework" ]
+    }
   }
 }
 
@@ -264,6 +266,9 @@
       "--android_platform=android-" + ndk_api,
     ]
   }
+  if (is_ios && ios_use_simulator) {
+    args += [ "--ios_use_simulator" ]
+  }
 
   if (dawn_enable_d3d11) {
     args += [ "--dawn_enable_d3d11=true" ]
# Select the iOS/tvOS SDK and disable Tint command-line tools for cross builds.
diff --git a/third_party/dawn/build_dawn.py b/third_party/dawn/build_dawn.py
--- a/third_party/dawn/build_dawn.py
+++ b/third_party/dawn/build_dawn.py
@@ -174,9 +174,16 @@
     configure_cmd.append(f"-DCMAKE_C_COMPILER={args.cc.replace(os.sep, '/')}")
     configure_cmd.append(f"-DCMAKE_CXX_COMPILER={args.cxx.replace(os.sep, '/')}")
 
-  if target_os == "Darwin" or target_os == "iOS":
+  if target_os in ("Darwin", "iOS", "tvOS"):
     configure_cmd.append(f"-DCMAKE_OSX_ARCHITECTURES={target_cpu}")
 
+  if target_os in ("iOS", "tvOS"):
+    configure_cmd.append("-DTINT_BUILD_CMD_TOOLS=OFF")
+    # iphoneos/iphonesimulator, appletvos/appletvsimulator
+    sdk = "iphone" if target_os == "iOS" else "appletv"
+    sdk += "simulator" if args.ios_use_simulator else "os"
+    configure_cmd.append(f"-DCMAKE_OSX_SYSROOT={sdk}")
+
   env = os.environ.copy()
   # Don't write .pyc files, which can cause race conditions when building
   # tint and dawn in parallel.
# Accept the simulator option and map iOS/tvOS platforms and CPUs for CMake.
diff --git a/third_party/dawn/cmake_utils.py b/third_party/dawn/cmake_utils.py
--- a/third_party/dawn/cmake_utils.py
+++ b/third_party/dawn/cmake_utils.py
@@ -56,6 +56,8 @@
   parser.add_argument("--is_clang", action=argparse.BooleanOptionalAction)
   parser.add_argument(
       "--enable_rtti", action=argparse.BooleanOptionalAction, help="Enable RTTI.")
+  parser.add_argument(
+      "--ios_use_simulator", action=argparse.BooleanOptionalAction, help="Build for Apple simulator.")
 
 def add_next_batch_to_command(base_cmd, workset):
   if sys.platform != 'win32':
@@ -234,6 +236,13 @@
     }
     return "Darwin", target_cpu_map[cpu]
 
+  if os in ("ios", "tvos"):
+    target_cpu_map = {
+      "arm64": "arm64",
+      "x64": "x86_64",
+    }
+    return "tvOS" if os == "tvos" else "iOS", target_cpu_map[cpu]
+
   if os == "win":
     target_cpu_map = {
       "arm64": "ARM64",
