{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["dom", "es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": ["scripts", "smoke", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
